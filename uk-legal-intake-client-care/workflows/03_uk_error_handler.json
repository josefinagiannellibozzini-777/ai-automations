{
  "name": "UK Legal – Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "25d1345a-5919-4822-b7dd-8f9e1256f11c",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        64,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turns the raw n8n error into clean fields\nconst e = $json.execution || {};\nconst w = $json.workflow || {};\nconst trigger = $json.trigger || {};\nreturn [{ json: {\n  timestamp: $now.setZone('Europe/London').toFormat('yyyy-MM-dd HH:mm:ss'),\n  workflow: w.name || 'Unknown workflow',\n  failed_node: e.lastNodeExecuted || trigger?.error?.node?.name || 'Trigger',\n  error_message: (e.error?.message || trigger?.error?.message || 'Unknown error').slice(0, 500),\n  execution_id: e.id || 'n/a',\n  execution_url: e.url || ''\n} }];"
      },
      "id": "3c1cb70f-0c78-4c07-930e-7e07714010b9",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        336
      ]
    },
    {
      "parameters": {
        "sendTo": "solicitor@example.com",
        "subject": "=⚠️ Workflow failed: {{ $json.workflow }}",
        "message": "=<h3>An automation failed and needs attention</h3><p><b>Workflow:</b> {{ $json.workflow }}<br><b>Failed node:</b> {{ $json.failed_node }}<br><b>Time (UK):</b> {{ $json.timestamp }}<br><b>Error:</b> {{ $json.error_message }}</p><p><a href=\"{{ $json.execution_url }}\">Open the failed execution in n8n</a></p><p style=\"color:#777;font-size:12px\">The client was not affected by a partial action if the failure happened before an email was sent. Please review the execution and retry it.</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "858576f0-4170-4770-9460-d0187ea2eb80",
      "name": "Alert Team (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
