      "id": "a91a6a58-9bd4-460a-be54-e3b2b549f902",
      "name": "Find Client in Intake Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        32,
        224
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Merges the solicitor's form with the client's ACCEPTED intake record\nconst form = $('Open New Matter (Form)').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.email);\nconst accepted = rows.filter(r => String(r.attorney_decision).toLowerCase() === 'accepted');\nconst rec = accepted[accepted.length - 1];\n\nconst d = {\n  client_name: rec?.full_name,\n  client_email: form['Client email'],\n  matter_type: rec?.practice_area,\n  matter_description: rec?.case_summary,\n  opposing_party: rec?.opposing_party,\n  fee_type: String(form['Fee type'] || '').toLowerCase(),\n  fee_amount: form['Fee amount (£)'],\n  fee_estimate: form['Fee estimate (£)'],\n  solicitor_name: form['Solicitor name'],\n  solicitor_email: form['Solicitor email'],\n  supervisor_name: form['Supervisor name'],\n  firm_name: 'Mitchell & Chen Solicitors'\n};\n\nconst problems = [];\nif (!rec) problems.push(`No ACCEPTED intake found for ${form['Client email']} in the Intake Log`);\nif (!['hourly', 'fixed'].includes(d.fee_type)) problems.push('Fee type must be Hourly or Fixed');\nif (!(Number(d.fee_amount) > 0)) problems.push('Fee amount must be greater than 0');\nfor (const f of ['solicitor_name', 'solicitor_email', 'supervisor_name']) {\n  if (!d[f] || String(d[f]).trim() === '') problems.push(f);\n}\n\nconst today = new Date();\nconst ref = 'CCL-' + today.toISOString().slice(0,10).replace(/-/g,'') + '-' + Math.floor(1000 + Math.random() * 9000);\n\nreturn [{ json: {\n  ...d,\n  valid: problems.length === 0,\n  missing_fields: problems.join(', '),\n  letter_ref: ref,\n  letter_date: today.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })\n} }];"
      },
