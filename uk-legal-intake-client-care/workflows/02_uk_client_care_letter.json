    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a legal assistant at a UK law firm. Write the personalised parts of a Client Care Letter.\n\nClient name: {{ $json.client_name }}\nType of matter: {{ $json.matter_type }}\nCase summary from intake: {{ $json.matter_description }}\nOpposing party: {{ $json.opposing_party }}\n\nRules:\n- Plain, professional British English. No legal advice, no promises about the outcome.\n- Do NOT mention fees, prices or deadlines (they are added separately).\n- Return ONLY valid JSON, no markdown, with this exact structure:\n{\n  \"scope_summary\": \"2-3 sentences describing the work the firm will do for the client\",\n  \"out_of_scope\": \"1 sentence on what is not included\",\n  \"next_steps\": [\"step 1\", \"step 2\", \"step 3\"]\n}"
      },
      "id": "113d01a4-153c-43c6-a640-2336da564b27",
      "name": "AI: Write Scope & Next Steps",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        688,
        112
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.3
        }
      },
      "id": "dd88c59f-605e-4fba-8fa7-175e9423db7b",
      "name": "Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        688,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parses the AI output and builds the full letter.\n// Fees, complaints and regulation text are FIXED (not written by the AI).\nconst src = $('Validate Request').first().json;\n\nlet ai;\ntry {\n  const raw = String($json.text).replace(/```json|```/g, '').trim();\n  ai = JSON.parse(raw);\n} catch (e) {\n  throw new Error('AI output was not valid JSON: ' + $json.text);\n}\nif (!ai.scope_summary || !Array.isArray(ai.next_steps)) {\n  throw new Error('AI output is missing required fields');\n}\n\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nconst fees = src.fee_type === 'hourly'\n  ? `Our charges are based on the time spent on your matter. The hourly rate of ${esc(src.solicitor_name)} is £${esc(src.fee_amount)} plus VAT.` +\n    (src.fee_estimate ? ` Based on the information you have given us, we estimate the total cost will be around £${esc(src.fee_estimate)} plus VAT. We will tell you straight away if this estimate changes.` : '')\n  : `We will charge a fixed fee of £${esc(src.fee_amount)} plus VAT for the work described above.`;\n\nconst steps = ai.next_steps.map(s => `<li>${esc(s)}</li>`).join('');\n\nconst letter_html = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#222;max-width:680px\">\n  <p><strong>${esc(src.firm_name)}</strong><br>Ref: ${src.letter_ref}<br>${src.letter_date}</p>\n  <p>Dear ${esc(src.client_name)},</p>\n  <p>Thank you for choosing ${esc(src.firm_name)}. This letter confirms the terms on which we will act for you.</p>\n\n  <h3>Your matter</h3>\n  <p>${esc(ai.scope_summary)}</p>\n  <p>${esc(ai.out_of_scope)}</p>\n\n  <h3>Who will handle your matter</h3>\n  <p>Your matter will be handled by ${esc(src.solicitor_name)}, supervised by ${esc(src.supervisor_name)}.</p>\n\n  <h3>Our fees</h3>\n  <p>${fees}</p>\n\n  <h3>Next steps</h3>\n  <ul>${steps}</ul>\n\n  <h3>Complaints</h3>\n  <p>If you are unhappy with our service, please contact ${esc(src.supervisor_name)} first. We will try to resolve your concern within 8 weeks. If you are still not satisfied, you can contact the Legal Ombudsman.</p>\n\n  <h3>Regulation</h3>\n  <p>${esc(src.firm_name)} is authorised and regulated by the Solicitors Regulation Authority (SRA).</p>\n\n  <p>Please reply to this email to confirm that you agree to these terms.</p>\n  <p>Kind regards,<br>${esc(src.solicitor_name)}<br>${esc(src.firm_name)}</p>\n</div>`;\n\nreturn [{ json: {\n  ...src,\n  subject: `Client Care Letter – ${src.matter_type} – Ref ${src.letter_ref}`,\n  letter_html\n} }];"
      },
