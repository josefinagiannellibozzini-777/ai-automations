    },
    {
      "parameters": {
        "sendTo": "={{ $('Normalize Intake Data').first().json.email }}",
        "subject": "Next Step: Schedule Your Consultation – Mitchell & Chen Solicitors",
        "message": "=<p>Dear {{ $('Normalize Intake Data').first().json.full_name }},</p>  <p>Thank you for contacting Mitchell & Chen Solicitors. A solicitor has reviewed the information you submitted about your {{ $('Normalize Intake Data').first().json.practice_area }} matter, and we would like to meet with you for an initial consultation.</p>  <p>Please choose a time that works for you using the link below:</p>  <p style=\"text-align:center;margin:28px 0;\">   <a href=\"https://meetings.hubspot.com/YOUR-SCHEDULING-LINK\" style=\"background-color:#1a3c5e;color:#ffffff;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold;\">Schedule My Consultation</a> </p>  <p><b>To make the most of your consultation, please have ready:</b></p> <ul>   <li>Any documents related to your situation (letters, contracts, photos, medical records or invoices)</li>   <li>Names and contact information of anyone involved</li>   <li>A timeline of what happened</li> </ul>  <p>If you have any questions before your appointment, simply reply to this email.</p>  <p>Sincerely,<br> Client Intake Team<br> Mitchell & Chen Solicitors</p>  <p style=\"font-size:12px;color:#777;\">This message does not create a solicitor-client relationship. We will only act for you once you have received and accepted our Client Care Letter.</p>",
        "options": {
          "appendAttribution": false
        }
      },
