    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "solicitor@example.com",
        "subject": "=[{{ $('Conflict Check (AI)').first().json.output.conflict_status }}] \nNew Intake: {{ $('Normalize Intake Data').first().json.full_name }} – {{ $('Normalize Intake Data').first().json.practice_area }}",
        "message": "=<h2>New Client Intake – Solicitor Review Required</h2>\n\n<h3>Prospective Client</h3>\n<p><b>Name:</b> {{ $('Normalize Intake Data').first().json.full_name }}</p>\n<p><b>Email:</b> {{ $('Normalize Intake Data').first().json.email }}</p>\n<p><b>Phone:</b> {{ $('Normalize Intake Data').first().json.phone }}</p>\n<p><b>Practice area:</b> {{ $('Normalize Intake Data').first().json.practice_area }}</p>\n<p><b>Opposing party:</b> {{ $('Normalize Intake Data').first().json.opposing_party }}</p>\n\n<h3>Conflict Check: {{ $('Conflict Check (AI)').first().json.output.conflict_status }}</h3>\n<p>{{ $('Conflict Check (AI)').first().json.output.conflict_reason }}</p>\n\n<h3>Case Evaluation</h3>\n<p><b>Quality:</b> {{ $json.output.case_quality }} – {{ $json.output.quality_reason }}</p>\n<p><b>Urgency:</b> {{ $json.output.urgency }} – {{ $json.output.urgency_reason }}</p>\n<p><b>Summary:</b> {{ $json.output.case_summary }}</p>\n\n<p><b>Key facts:</b></p>\n<ul>\n<li>{{ $json.output.key_facts.join('</li><li>') }}</li>\n</ul>\n\n<p><b>Recommended next step:</b> {{ $json.output.recommended_next_step }}</p>\n\n<h3>Client's Original Description</h3>\n<p><i>{{ $('Normalize Intake Data').first().json.description }}</i></p>",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Accept Case",
            "disapproveLabel": "Decline Case"
          }
        },
        "options": {
          "appendAttribution": false
        }
      },
