    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"case_summary\": \"The prospective client owns a cleaning company that provided services to Brightwell Dental Practice Ltd. Three invoices remain unpaid.\",\n  \"key_facts\": [\"Unpaid invoices totaling £8,500\", \"Service relationship of 8 months\", \"Opposing party: Brightwell Dental Practice Ltd\"],\n  \"urgency\": \"Low\",\n  \"urgency_reason\": \"No upcoming court date or deadline was reported.\",\n  \"case_quality\": \"Qualified\",\n  \"quality_reason\": \"Commercial Law matter with an identifiable opposing party and clear damages.\",\n  \"recommended_next_step\": \"Do not proceed until the conflict is reviewed by the responsible solicitor.\"\n}"
      },
