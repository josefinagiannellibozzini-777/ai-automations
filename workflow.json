    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"supplier\": { \"type\": [\"string\", \"null\"], \"description\": \"Name of the company that issued the invoice\" },\n    \"supplier_tax_id\": { \"type\": [\"string\", \"null\"], \"description\": \"Tax ID of the issuer, NOT the Bill to customer\" },\n    \"invoice_number\": { \"type\": [\"string\", \"null\"] },\n    \"issue_date\": { \"type\": [\"string\", \"null\"], \"description\": \"Format YYYY-MM-DD\" },\n    \"due_date\": { \"type\": [\"string\", \"null\"], \"description\": \"Format YYYY-MM-DD\" },\n    \"subtotal\": { \"type\": [\"number\", \"null\"] },\n    \"vat\": { \"type\": [\"number\", \"null\"] },\n    \"total\": { \"type\": [\"number\", \"null\"] },\n    \"currency\": { \"type\": [\"string\", \"null\"], \"description\": \"ISO code, e.g. ARS or USD\" }\n  },\n  \"required\": [\"supplier\", \"supplier_tax_id\", \"invoice_number\", \"issue_date\", \"due_date\", \"subtotal\", \"vat\", \"total\", \"currency\"]\n}",
        "options": {
          "systemPromptTemplate": "You are an accounts payable assistant. Extract the invoice data from the text exactly as it appears.\n- The supplier is the company that issued the invoice, never the \"Bill to\" customer.\n- Return amounts as plain numbers without thousand separators (e.g. 124872.00).\n- If a field is not present in the text, return null. Never guess or calculate missing values."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        448,
        0
      ],
      "id": "981a9528-6967-4967-8dad-ea9f97ff85bd",
      "name": "AI - Extract Invoice Data"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "list",
          "cachedResultName": "Chías - Supplier Invoices",
