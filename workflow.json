      "id": "175ea097-4482-49c9-8b12-e6edf4eff788",
      "name": "Check Duplicate",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "qgyvZz7p5Bv6KnoC",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Data extracted by the AI\nconst data = $('AI - Extract Invoice Data').first().json.output;\n\n// Rows found in the Invoices sheet (ignore the empty item)\nconst matches = $('Check Duplicate').all().filter(i => Object.keys(i.json).length > 0);\n\nconst reasons = [];\n\n// 1. Required fields\nconst required = ['supplier', 'supplier_tax_id', 'invoice_number', 'issue_date', 'due_date', 'subtotal', 'vat', 'total', 'currency'];\nfor (const field of required) {\n  if (data[field] === null || data[field] === undefined || data[field] === '') {\n    reasons.push(`Missing ${field}`);\n  }\n}\n\n// 2. Math check: subtotal + VAT must equal total (1 unit tolerance for rounding)\nif ([data.subtotal, data.vat, data.total].every(n => typeof n === 'number')) {\n  const expected = data.subtotal + data.vat;\n  if (Math.abs(expected - data.total) > 1) {\n    reasons.push(`Total mismatch: subtotal + VAT = ${expected.toFixed(2)}, invoice total = ${data.total.toFixed(2)}`);\n  }\n}\n\n// 3. Duplicate check\nif (matches.length > 0) {\n  reasons.push('Duplicate: invoice already registered');\n}\n\nconst fileName = $('Gmail Trigger - New Invoice').first().binary?.attachment_0?.fileName || '';\n\nreturn [{\n  json: {\n    processed_at: $now.setZone('America/Argentina/Buenos_Aires').toFormat('yyyy-MM-dd HH:mm'),\n    ...data,\n    file_name: fileName,\n    is_valid: reasons.length === 0,\n    reason: reasons.join('; ')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
