    {
      "parameters": {
        "jsCode": "// 1. Get the list of answers sent by Tally\nconst fields = $input.first().json.body.data.fields;\n\n// 2. Create an empty object for the clean data\nconst result = {};\n\n// 3. Loop through every field\nfor (const field of fields) {\n  let value = field.value;\n\n  // 4. If the question has options, replace the ID with the option text\n  if (field.options && Array.isArray(field.value)) {\n    const selected = field.options\n      .filter(option => field.value.includes(option.id))\n      .map(option => option.text);\n\n    value = selected[0]; // single choice\n  }\n\n  // 5. Use the question title as the key\n  result[field.label] = value;\n}\n\n// 6. Return only the clean object\nreturn [{ json: result }];"
      },
